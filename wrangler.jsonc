{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lead-inbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lead-inbox",
      "database_id": "cb4eaad3-8963-45e1-8505-996d56057dbc",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  "vars": { "OWNER_USERNAME": "owner" }
}
